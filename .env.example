# FinanceMaker Environment Variables
# Copy this file to .env and fill in your actual API keys
# WARNING: .env file is in .gitignore - never commit it to git

# ============================================================================
# AI PROVIDER API KEYS (Required for AI Consensus Scanner)
# ============================================================================

# Grok AI API Key
# Get it from: https://console.x.ai/
# Required for: EarningTomorrowAI consensus analysis with Grok
GROK_API_KEY=JUST_EXAMPLE

# Google Gemini API Key  
# Get it from: https://ai.google.dev/
# Required for: EarningTomorrowAI consensus analysis with Gemini
GEMINI_API_KEY=EXMAPLEKEY

# ============================================================================
# APPLICATION SETTINGS (Optional)
# ============================================================================

# Debug mode (enables verbose logging)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Live broker selector: alpaca or ibkr
BROKER_PROVIDER=alpaca

# HTTP Client timeout in seconds (affects all API calls)
HTTP_TIMEOUT=999999

# End-of-day email report (SMTP)
EOD_REPORT_ENABLED=true
EOD_REPORT_RECIPIENT_EMAIL=betterlokaki@gmail.com
EOD_REPORT_SENDER_EMAIL=your_email@gmail.com
EOD_REPORT_SMTP_HOST=smtp.gmail.com
EOD_REPORT_SMTP_PORT=587
EOD_REPORT_SMTP_USERNAME=your_email@gmail.com
EOD_REPORT_SMTP_PASSWORD=your_smtp_or_app_password
EOD_REPORT_USE_TLS=true
EOD_REPORT_SINCE_MONTH=4
EOD_REPORT_SINCE_DAY=1

TOKEN_ACCESS=TOKEN_ACCESS_EXAMPLE
TOKEN_SECRET=TOKEN_SECRET_EXAMPLE
SIGNATURE_KEY_PATH=PRIVATE_KEY_PATH_EXAMPLE
ENCRYPTION_KEY_PATH=PRIVATE_ENCRYPTION_KEY_PATH_EXAMPLE
DHPARAM_PATH=PRIVATE_DHPARAM_PATH_EXAMPLE

# ============================================================================
# ALPACA BROKER (Required for MAG7 live runner when broker_provider=alpaca)
# ============================================================================

ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
ALPACA_PAPER=true
# ALPACA_URL_OVERRIDE=

# ============================================================================
# NOTES
# ============================================================================
# 1. Both GROK_API_KEY and GEMINI_API_KEY are optional but recommended
#    - If both provided: Full AI consensus analysis available
#    - If only one: Scanner will use that provider's suggestions
#    - If none: AI scanner will fail gracefully with informative error
#
# 2. To get API keys:
#    - Grok: Visit https://console.x.ai/ and create API key
#    - Gemini: Visit https://ai.google.dev/ and create API key
#
# 3. Setup steps:
#    a. Copy this file to .env:
#       cp .env.example .env
#    b. Edit .env and fill in your API keys
#    c. Never commit .env to git (already in .gitignore)
#
# 4. Configuration priority (highest to lowest):
#    Environment Variables (.env) > YAML config > Code defaults
